{
  "name": "obsidian-linter",
  "version": "1.33.0",
  "description": "Enforces consistent markdown styling for Obsidian (https://obsidian.md). It can be used to format YAML tags, aliases, arrays, and metadata; footnotes; headings; spacing; math blocks; regular markdown contents like list, italics, and bold styles; and more with the use of custom rule options as well.",
  "main": "main.js",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "postinstall": "patch-package",
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "test": "jest",
    "test-suite": "jest -t \"$1\"",
    "docs": "node docs.js",
    "translate": "npm run build && node translation-helper.js",
    "compile": "npm run build && npm run docs && npm run lint && npm run test",
    "lint": "npx eslint --fix",
    "clear-jest": "jest --clearCache",
    "minify-css": "postcss src/styles.css -o styles.css"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/plugin-proposal-decorators": "^7.29.7",
    "@babel/plugin-transform-class-properties": "^7.29.7",
    "@babel/plugin-transform-class-static-block": "^7.29.7",
    "@babel/plugin-transform-private-methods": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@codemirror/view": "^6.38.6",
    "@eslint/js": "^10.0.1",
    "@jest/types": "^30.5.1",
    "@jteppinette/babel-plugin-import-glob": "^0.3.0",
    "@types/async-lock": "^1.4.2",
    "@types/diff-match-patch": "^1.0.32",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.2",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "babel-jest": "^30.5.1",
    "cssnano": "^7.1.9",
    "esbuild": "^0.28.0",
    "esbuild-plugin-import-glob": "^0.1.1",
    "esbuild-plugin-replace": "^2.0.0",
    "eslint": "^10.10.0",
    "eslint-plugin-jest": "^29.16.6",
    "eslint-plugin-obsidian-linter": "file:./eslint-rules",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "eslint-plugin-unicorn": "^65.0.1",
    "expect": "^30.5.1",
    "globals": "^17.12.0",
    "jest": "^30.5.1",
    "moment": "2.29.4",
    "obsidian": "^1.13.0",
    "patch-package": "^8.0.1",
    "postcss": "^8.5.28",
    "postcss-cli": "^11.0.1",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "unified-lint-rule": "^3.0.1"
  },
  "dependencies": {
    "async-lock": "^1.4.1",
    "diff-match-patch": "^1.0.5",
    "loglevel": "^1.9.2",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-frontmatter": "^2.0.1",
    "mdast-util-gfm-footnote": "^2.1.0",
    "mdast-util-gfm-task-list-item": "^2.0.0",
    "mdast-util-math": "^3.0.0",
    "micromark-extension-frontmatter": "^2.0.0",
    "micromark-extension-gfm-footnote": "^2.1.0",
    "micromark-extension-gfm-task-list-item": "^2.1.0",
    "micromark-extension-math": "^3.1.0",
    "micromark-util-combine-extensions": "^2.0.1",
    "moment-parseformat": "^4.0.0",
    "quick-lru": "^7.3.0",
    "ts-dedent": "^2.3.0",
    "unist-util-visit": "^5.1.0",
    "yaml": "^2.9.1"
  }
}
